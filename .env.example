# ==========================================
# CINEBOOK - Variáveis de Ambiente
# ==========================================

# TMDB - The Movie Database (Servidor apenas)
# Obtenha em https://www.themoviedb.org/settings/api
# Token de leitura v4 (Bearer) - NUNCA exposto no navegador:
TMDB_READ_ACCESS_TOKEN="seu_token_v4_aqui"

# Ou Chave de API v3 do TMDB (opcional):
TMDB_API_KEY="sua_chave_v3_aqui"

# GEMINI_API_KEY (injetado automaticamente pelo AI Studio se necessário)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL
APP_URL="MY_APP_URL"


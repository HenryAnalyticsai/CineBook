# ==========================================
# CINEBOOK - Variáveis de Ambiente
# ==========================================

# TMDB - The Movie Database (Servidor e Deploy Externo)
# Obtenha sua chave gratuita em https://www.themoviedb.org/settings/api
# Token de leitura v4 (Bearer):
TMDB_READ_ACCESS_TOKEN="seu_token_v4_aqui"

# Chave de API v3 do TMDB (Servidor):
TMDB_API_KEY="sua_chave_v3_aqui"

# Chave de API para deploy estático frontend (Vercel, Netlify, Firebase Hosting):
VITE_TMDB_API_KEY="sua_chave_v3_aqui"
VITE_TMDB_READ_ACCESS_TOKEN="seu_token_v4_aqui"

# GEMINI_API_KEY (opcional / injetado se necessário)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL
APP_URL="MY_APP_URL"

